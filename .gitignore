yarn-error.*
*.log

# macOS
.DS_Store

# local env files (sensitive — keep .env.example if you add one)
.env
.env.*
!.env.example

# package registry tokens (sensitive)
.npmrc
.yarnrc
.yarnrc.yml

# editor / IDE
.idea/
*.iml

# local databases / app data (personal data)
*.db
*.sqlite
*.sqlite3

